# =================================================================
# Django Backend Environment Configuration Template
# =================================================================
# Copy this file to .env and configure values for your environment.
# NEVER commit real secrets or production credentials to source control.

# --- Security & Core ---
# In production, generate a secure random 50+ character string:
# python -c 'import secrets; print(secrets.token_urlsafe(50))'
DJANGO_SECRET_KEY=

# Set to False in production:
DJANGO_DEBUG=True

# Comma-separated list of valid host/domain names:
# e.g. example.com,www.example.com,api.example.com
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,testserver

# --- Database ---
# Choose 'sqlite' (default fallback) or 'postgres':
DB_ENGINE=sqlite
POSTGRES_DB=naruto_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# --- CORS & CSRF ---
# Comma-separated allowed frontend origins for CORS:
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Comma-separated trusted origins for CSRF protection:
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- HTTPS & Security (Effective when DJANGO_DEBUG=False) ---
# Set to True when served over HTTPS / reverse proxy:
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True
SECURE_PROXY_SSL_HEADER=False
